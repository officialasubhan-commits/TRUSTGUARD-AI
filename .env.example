# API base URL for communication with the FastAPI backend.
# In local development: http://localhost:8000/api/v1
# In production: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Google OAuth Client ID for frontend Google Identity Services
VITE_GOOGLE_CLIENT_ID=


