# TrustGuard AI — Frontend Environment Variables Example
# In production, set this to your Render backend API URL
VITE_API_BASE_URL=https://trustguard-ai-a154.onrender.com/api/v1

# In local development, use localhost
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (must match backend configuration)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
