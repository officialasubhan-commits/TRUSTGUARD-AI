# ==============================================================================
# TrustGuard AI — Backend Environment Configuration Example
#
# Instructions:
# 1. Copy this template to create your local environment file:
#    cp .env.example .env     (Linux/macOS)
#    Copy-Item .env.example .env (Windows PowerShell)
# 2. In local development, the application runs out-of-the-box with decoupled
#    mock stores even if Supabase and VirusTotal credentials are left empty.
# 3. In production, Supabase and VirusTotal credentials are required.
# 4. NEVER commit the actual ".env" file or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS (MANDATORY IN ALL ENVIRONMENTS)
# Safe defaults are provided for local development.
# ------------------------------------------------------------------------------
APP_NAME="TrustGuard AI"
APP_ENV=development          # Options: development | staging | production
APP_DEBUG=true               # Set false in production
APP_VERSION=0.1.0

# Network interface and port binding
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT ACCESS (MANDATORY FOR FRONTEND INTEGRATION)
# Comma-separated list of allowed frontend origins that may call this API.
# ------------------------------------------------------------------------------
FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. RATE LIMITING CONFIGURATION (MANDATORY FOR SECURITY DEFAULTS)
# Rate limits enforced on client IP addresses to prevent abuse and denial of service.
# ------------------------------------------------------------------------------
RATE_LIMIT_SCAN="5/minute"     # Limit applied to POST /api/v1/scan
RATE_LIMIT_GLOBAL="60/minute"  # Limit applied to all other endpoints

# ------------------------------------------------------------------------------
# 4. SUPABASE POSTGRESQL & AUTHENTICATION (BACKEND-ONLY SECRETS)
# - OPTIONAL in development (application automatically uses local in-memory store).
# - MANDATORY in production for persistent database records and live authentication.
# - Obtain from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Settings -> API -> Project URL)
SUPABASE_URL=

# Supabase Public Anonymous API Key (Settings -> API -> Project API keys -> anon/public)
SUPABASE_ANON_KEY=

# Supabase Secret Service Role Key (Settings -> API -> Project API keys -> service_role)
# CRITICAL: Backend-only secret. Bypasses Row Level Security. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Settings -> API -> JWT Settings -> JWT Secret)
# Used server-side to verify cryptographic HMAC SHA-256 signatures on Bearer tokens.
SUPABASE_JWT_SECRET=

# (Optional) Direct PostgreSQL connection URI for SQLAlchemy / asyncpg
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY THREAT INTELLIGENCE (BACKEND-ONLY SECRETS)
# - OPTIONAL: If omitted, the system gracefully marks VirusTotal as API_UNAVAILABLE
#   and dynamically redistributes scoring weights across remaining active modules.
# - Obtain free API key from: https://www.virustotal.com/gui/user/_/apikey
# ------------------------------------------------------------------------------
# VirusTotal v3 REST API Key (Free tier allows 4 requests/min, 500 requests/day)
VIRUSTOTAL_API_KEY=

# VirusTotal v3 API Base Endpoint (Default: official v3 API)
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# In-memory response cache duration in seconds to respect free-tier rate limits
VIRUSTOTAL_CACHE_TTL_SECONDS=3600

# URLhaus by Abuse.ch (Queries are free and public; no API key required)
URLHAUS_API_KEY=""

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH CONFIGURATION (FOR SOCIAL LOGIN)
# - Configure these in your Google Cloud Console (OAuth Client ID & Secret).
# - Also configure them in your Supabase Dashboard (Auth -> Providers -> Google).
# - Permitted redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

